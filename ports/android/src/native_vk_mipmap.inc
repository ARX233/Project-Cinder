/* Independent immutable GPU mip generation, included after native_vk_images.inc.
 * Only the bounded base span is copied/conversion-packed on the CPU; every
 * lower level is generated by Vulkan linear blits, never a CPU mip surrogate.
 * Returned loader resources still require the platform's completed fence handoff. */
uint32_t cinder_vk_texture_generate_mips(const cinder_vk_texture_desc *base) {
  native_texture_format_info format;
  if (!base || base->width <= 0 || base->height <= 0 || base->levels <= 0 || base->levels > 31 ||
      base->levels != full_levels(base->width, base->height) || base->layers != 1 ||
      base->sampler.use_state != VK_TRUE || !native_sampler_valid(&base->sampler) ||
      !native_texture_format(base->format, &format) || format.block != 1 ||
      !base->subresources || base->subresource_count != 1) {
    native_reject(); return 0;
  }
  const cinder_vk_texture_subresource *source = base->subresources;
  if (source->level || source->layer || !source->data ||
      (size_t)base->width > SIZE_MAX / format.src_bpp || (size_t)base->width > SIZE_MAX / format.dst_bpp) {
    native_reject(); return 0;
  }
  size_t rows = (size_t)base->height;
  size_t source_row = (size_t)base->width * format.src_bpp;
  size_t output_row = (size_t)base->width * format.dst_bpp;
  size_t stride = source->row_stride ? source->row_stride : source_row;
  if (stride < source_row || (rows - 1 && stride > (SIZE_MAX - source_row) / (rows - 1)) ||
      rows > SIZE_MAX / output_row) { native_reject(); return 0; }
  size_t span = (rows - 1) * stride + source_row;
  size_t size = rows * output_row;
  if (span > source->bytes || span > PTRDIFF_MAX || size > PTRDIFF_MAX ||
      (uintptr_t)source->data > UINTPTR_MAX - (span - 1)) { native_reject(); return 0; }
  /* The format-properties resource-size bound covers the complete output,
   * including levels with no CPU source span. Never overflow this estimate. */
  size_t total = 0;
  uint32_t w = (uint32_t)base->width, h = (uint32_t)base->height;
  for (int level = 0; level < base->levels; ++level) {
    if ((size_t)w > SIZE_MAX / format.dst_bpp || (size_t)h > SIZE_MAX / ((size_t)w * format.dst_bpp)) {
      native_reject(); return 0;
    }
    size_t bytes = (size_t)w * format.dst_bpp * h;
    if (total > SIZE_MAX - bytes) { native_reject(); return 0; }
    total += bytes;
    w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1;
  }
  uploader *u = native_resource_up();
  int linear = base->sampler.min_filter == VK_FILTER_LINEAR || base->sampler.mag_filter == VK_FILTER_LINEAR ||
    (base->sampler.mipmaps && base->sampler.mipmap_mode == VK_SAMPLER_MIPMAP_MODE_LINEAR);
  if (!u || !native_texture_capabilities(&format, (uint32_t)base->width, (uint32_t)base->height,
                                        (uint32_t)base->levels, 1, linear || base->levels > 1, total) ||
      (base->levels > 1 && !fmt_has(format.format, VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT))) {
    native_reject(); return 0;
  }
  const VkImageUsageFlags usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
  vimg *im = image_new_usage(format.format, base->width, base->height, base->levels, 1, 1, 1, 0, format.swizzle, usage);
  if (!im) { native_reject(); return 0; }
  if (im->view_levels != base->levels) {
    VkImageView view = VK_NULL_HANDLE;
    if (view_try(im, 1, base->levels, &view) != VK_SUCCESS || !view) {
      if (view) vkDestroyImageView(D.dev, view, NULL);
      image_free_now(im); native_reject(); return 0;
    }
    /* Unpublished and unused: replace the constructor's level-zero view. */
    if (im->view) vkDestroyImageView(D.dev, im->view, NULL);
    im->view = view; im->view_levels = base->levels;
  }
  size_t stage_i = u->stage.i;
  VkDeviceSize stage_used = u->stage.used;
  VkBuffer staging = VK_NULL_HANDLE;
  VkDeviceSize offset = 0;
  uint8_t *dst = native_ring_alloc(&u->stage, size, 16, &staging, &offset);
  if (!dst || !staging || offset > UINT64_MAX - size || offset % 16) {
    u->stage.i = stage_i; u->stage.used = stage_used;
    image_free_now(im); native_reject(); return 0;
  }
  /* Byte-safe, bounded equivalents of the immutable factory's base conversion.
   * No lower-level pixels are read or computed here. Stage owns all source bytes
   * before begin/lease and the caller may mutate its CPU input after return. */
  for (size_t row = 0; row < rows; ++row) {
    const uint8_t *src = (const uint8_t *)source->data + row * stride;
    uint8_t *out = dst + row * output_row;
    if (format.conversion == NATIVE_TEXTURE_RGB_RGBA) {
      for (size_t x = 0; x < (size_t)base->width; ++x) {
        memcpy(out + 4 * x, src + 3 * x, 3); out[4 * x + 3] = 255;
      }
    } else if (format.conversion == NATIVE_TEXTURE_5551_1555) {
      for (size_t x = 0; x < (size_t)base->width; ++x) {
        uint16_t value; memcpy(&value, src + 2 * x, sizeof value);
        value = (uint16_t)((value >> 1) | ((value & 1u) << 15));
        memcpy(out + 2 * x, &value, sizeof value);
      }
    } else memcpy(out, src, source_row);
  }
  uint32_t id = tex_gen();
  vtex *texture = tex_get(id);
  if (!id || !texture) {
    u->stage.i = stage_i; u->stage.used = stage_used;
    if (id) tex_release(id);
    image_free_now(im); native_reject(); return 0;
  }
  VkCommandBuffer cmd = native_up_cmd(u);
  if (!cmd || (native_upload_stream == CINDER_VK_UPLOAD_LOADER && !native_image_upload_hold(im))) {
    u->stage.i = stage_i; u->stage.used = stage_used;
    tex_release(id); image_free_now(im); native_reject(); return 0;
  }
  /* No rollback after the first image command, including auto-flush failures.
   * End/submit/wait failure retains unknown references. After a successful wait,
   * reset failure has known GPU completion but still retains the stage cursor. */
  barrier(cmd, im, 0, 1, 0, 1, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
  VkBufferImageCopy copy = { offset, 0, 0, { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, { 0, 0, 0 },
    { (uint32_t)base->width, (uint32_t)base->height, 1 } };
  vkCmdCopyBufferToImage(cmd, staging, im->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
  w = (uint32_t)base->width; h = (uint32_t)base->height;
  for (int level = 1; level < base->levels; ++level) {
    uint32_t next_w = w > 1 ? w / 2 : 1, next_h = h > 1 ? h / 2 : 1;
    barrier(cmd, im, level - 1, 1, 0, 1, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
    barrier(cmd, im, level, 1, 0, 1, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
    VkImageBlit blit = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, (uint32_t)level - 1, 0, 1 },
      .srcOffsets = { { 0, 0, 0 }, { (int32_t)w, (int32_t)h, 1 } },
      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, (uint32_t)level, 0, 1 },
      .dstOffsets = { { 0, 0, 0 }, { (int32_t)next_w, (int32_t)next_h, 1 } } };
    vkCmdBlitImage(cmd, im->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                   im->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
    barrier(cmd, im, level - 1, 1, 0, 1, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, im->rest);
    w = next_w; h = next_h;
  }
  barrier(cmd, im, base->levels - 1, 1, 0, 1, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, im->rest);
  im->level_mask = (1u << (unsigned)base->levels) - 1u;
  im->in_rest = im->defined = 1;
  texture->im = im;
  texture->native_sampler = base->sampler;
  if (native_upload_stream == CINDER_VK_UPLOAD_LOADER && u->stage.n > 4) {
    loader_flush();
    if (native_loader_failed) { cinder_vk_texture_destroy(id); native_reject(); return 0; }
  }
  return id;
}
